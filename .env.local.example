# --- APPLICATION BASE URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SUPABASE (Database, Auth, Realtime & Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- GROQ API (AI / LLM Inference - Llama 3.3 & Mixtral) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- UPSTASH REDIS (Rate Limiting, Cache, AI Queuing) ---
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# --- CLOUDFLARE R2 (Task Attachments Object Storage - S3-compatible, Zero Egress) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=tasq-one-attachments
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- RESEND (Transactional Email for Assignments & Notifications) ---
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="TASQ-ONE <notifications@yourdomain.com>"

# --- POSTHOG (Product Telemetry & Analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_client_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- SENTRY (Production Error Telemetry & Crash Reporting) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- CRON SECRET (Weekly AI Summary / Scheduled Tasks) ---
CRON_SECRET=your-random-cron-secret-32-chars

# --- STRIPE BILLING (Optional / Feature Flag Gated) ---
NEXT_PUBLIC_ENABLE_BILLING=false
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_ID_PRO=price_your_stripe_price_id_pro
STRIPE_PRICE_ID_ENTERPRISE=price_your_stripe_price_id_enterprise

