# ==============================================================================
# TASQ-ONE — Environment Variables Configuration
# Stack: Zero-AWS, 100% Free-Tier Architecture
# ==============================================================================

# --- SUPABASE (Database, Auth, Realtime & Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- GROQ API (AI / LLM Inference - Llama 3.3 & Mixtral) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- UPSTASH REDIS (Rate Limiting, Cache, AI Queuing) ---
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# --- CLOUDFLARE R2 (Task Attachments Object Storage - S3-compatible, Zero Egress) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=tasq-one-attachments
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- RESEND (Transactional Email for Assignments & Notifications) ---
RESEND_API_KEY=re_your_resend_api_key_here

# --- POSTHOG (Product Telemetry & Analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_client_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
